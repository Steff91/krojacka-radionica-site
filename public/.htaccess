# Apache (Plesk). Static site; the only server-side code is api/send.php (form handler).

# --- Security headers ---
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"
  # Enable only once HTTPS works on the final domain (browsers remember it for a year):
  # Header always set Strict-Transport-Security "max-age=31536000"
</IfModule>

# --- No directory listings ---
Options -Indexes

# --- Block hidden files (.git, .env …) ---
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteRule "(^|/)\.(?!well-known/)" - [F]

  # --- One address: https://krojackaradionicabg.rs (no www) ---
  # www → without www
  RewriteCond %{HTTP_HOST} ^www\.krojackaradionicabg\.rs$ [NC]
  RewriteRule ^ https://krojackaradionicabg.rs%{REQUEST_URI} [R=301,L]
  # http → https (also behind Cloudflare, which reports the visitor's scheme in headers)
  RewriteCond %{HTTP_HOST} ^krojackaradionicabg\.rs$ [NC]
  RewriteCond %{HTTPS} off
  RewriteCond %{HTTP:X-Forwarded-Proto} !https
  RewriteCond %{HTTP:CF-Visitor} !https
  RewriteRule ^ https://krojackaradionicabg.rs%{REQUEST_URI} [R=301,L]
</IfModule>

# --- Compression (text files; images and fonts are already compressed) ---
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml application/javascript text/javascript application/json application/xml image/svg+xml
</IfModule>

# --- Correct types for modern formats ---
<IfModule mod_mime.c>
  AddType image/webp .webp
  AddType font/woff2 .woff2
</IfModule>

# --- Custom 404 ---
ErrorDocument 404 /404.html

# --- Caching: hashed assets forever, HTML always fresh ---
<IfModule mod_headers.c>
  <FilesMatch "\.(woff2?|css|js)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.(webp|png|jpe?g|svg|ico)$">
    Header set Cache-Control "public, max-age=2592000"
  </FilesMatch>
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>

# --- /api/: only the form handler is reachable ---
<IfModule mod_rewrite.c>
  RewriteRule ^api/(?!send\.php$) - [F]
</IfModule>
