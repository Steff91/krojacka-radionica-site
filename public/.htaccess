# Apache (Plesk). Static site; the only server-side code is api/send.php (form handler).

# --- Security headers ---
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"
  # Enable only once HTTPS works on the final domain (browsers remember it for a year):
  # Header always set Strict-Transport-Security "max-age=31536000"
</IfModule>

# --- No directory listings ---
Options -Indexes

# --- Block hidden files (.git, .env …) ---
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteRule "(^|/)\.(?!well-known/)" - [F]
</IfModule>

# --- Custom 404 ---
ErrorDocument 404 /404.html

# --- Caching: hashed assets forever, HTML always fresh ---
<IfModule mod_headers.c>
  <FilesMatch "\.(woff2?|css|js)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.(webp|png|jpe?g|svg|ico)$">
    Header set Cache-Control "public, max-age=2592000"
  </FilesMatch>
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>

# --- /api/: only the form handler is reachable ---
<IfModule mod_rewrite.c>
  RewriteRule ^api/(?!send\.php$) - [F]
</IfModule>
