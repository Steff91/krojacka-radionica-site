---
// Full-screen photo viewer. Place inside an element with [data-lightbox-root] that also contains:
//  - buttons with [data-lightbox-open="<index>"] (hidden buttons are skipped while browsing)
//  - <script type="application/json" data-lightbox-items> with [{ src?, alt, link?: { href, label } }]
import Icon from './Icon.astro';
---

<dialog class="lightbox" aria-label="Pregled fotografija">
  <div class="flex h-full w-full flex-col">
    <div class="flex items-center justify-between px-4 py-4 text-on-dark sm:px-8">
      <span class="text-sm tracking-[0.12em]" data-lightbox-counter></span>
      <button type="button" class="lb-btn" data-lightbox-close aria-label="Zatvori">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="M5 5l14 14M19 5L5 19"></path></svg>
      </button>
    </div>
    <div class="relative flex min-h-0 flex-1 items-center justify-center px-4 pb-6 sm:px-24">
      <button type="button" class="lb-btn lb-nav left-3 sm:left-8" data-lightbox-prev aria-label="Prethodna fotografija">
        <Icon name="chevron-right" size={16} class="rotate-180" />
      </button>
      <figure class="m-0 flex h-full max-h-full w-full flex-col items-center justify-center gap-4">
        <img data-lightbox-img alt="" class="lb-img hidden max-h-[calc(100%-4.5rem)] max-w-full object-contain" />
        <div data-lightbox-placeholder class="placeholder hidden aspect-[4/5] h-[60vh] max-w-full !bg-ink-soft !text-on-dark-muted"></div>
        <figcaption class="flex flex-col items-center gap-2 text-center text-sm text-on-dark-muted">
          <span data-lightbox-caption></span>
          <a data-lightbox-link hidden class="inline-flex items-center gap-2 text-[13px] font-medium uppercase tracking-[0.12em] text-gold no-underline hover:text-on-dark"></a>
        </figcaption>
      </figure>
      <button type="button" class="lb-btn lb-nav right-3 sm:right-8" data-lightbox-next aria-label="Sledeća fotografija">
        <Icon name="chevron-right" size={16} />
      </button>
    </div>
  </div>
</dialog>

<style>
  .lightbox {
    width: 100vw; height: 100dvh; max-width: none; max-height: none;
    margin: 0; padding: 0; border: 0;
    background: var(--color-ink);
  }
  .lightbox::backdrop { background: var(--color-ink); }
  .lightbox[open] { animation: lb-in .3s ease; }
  @keyframes lb-in { from { opacity: 0; } to { opacity: 1; } }
  .lb-img { animation: lb-img-in .35s ease; }
  @keyframes lb-img-in { from { opacity: 0; transform: scale(.98); } to { opacity: 1; transform: none; } }

  .lb-btn {
    display: inline-flex; align-items: center; justify-content: center;
    width: 48px; height: 48px; border-radius: 4px; cursor: pointer;
    border: 1px solid var(--color-line-dark); background: rgba(45, 41, 38, .6); color: var(--color-on-dark);
    transition: border-color .3s ease, color .3s ease;
  }
  .lb-btn:hover { border-color: var(--color-gold); color: var(--color-gold); }
  .lb-nav { position: absolute; top: 50%; transform: translateY(-50%); z-index: 1; }
  /* Phones: arrows sit below the photo instead of covering it */
  @media (max-width: 639px) {
    .lb-nav { top: auto; bottom: 16px; transform: none; }
    .lightbox figure { padding-bottom: 64px; }
  }
  @media (prefers-reduced-motion: reduce) {
    .lightbox[open], .lb-img { animation: none; }
  }
</style>

<script>
  type Item = { src?: string; alt: string; link?: { href: string; label: string } };
  const clean = (s: string) => s.replace(/[[\]]/g, '');
  const chevron = '<svg width="7" height="11" viewBox="0 0 320 512" fill="currentColor" aria-hidden="true"><path d="M310.6 233.4c12.5 12.5 12.5 32.8 0 45.3l-192 192c-12.5 12.5-32.8 12.5-45.3 0s-12.5-32.8 0-45.3L242.7 256 73.4 86.6c-12.5-12.5-12.5-32.8 0-45.3s32.8-12.5 45.3 0l192 192z"></path></svg>';

  document.querySelectorAll<HTMLElement>('[data-lightbox-root]').forEach((root) => {
    const items: Item[] = JSON.parse(root.querySelector('[data-lightbox-items]')?.textContent ?? '[]');
    const dialog = root.querySelector<HTMLDialogElement>('.lightbox');
    if (!dialog) return;
    const img = dialog.querySelector<HTMLImageElement>('[data-lightbox-img]')!;
    const ph = dialog.querySelector<HTMLElement>('[data-lightbox-placeholder]')!;
    const caption = dialog.querySelector<HTMLElement>('[data-lightbox-caption]')!;
    const link = dialog.querySelector<HTMLAnchorElement>('[data-lightbox-link]')!;
    const counter = dialog.querySelector<HTMLElement>('[data-lightbox-counter]')!;
    const openers = [...root.querySelectorAll<HTMLElement>('[data-lightbox-open]')];

    let order: number[] = []; // item indexes currently browsable (visible buttons)
    let pos = 0;
    let opener: HTMLElement | null = null;

    const show = (p: number) => {
      pos = (p + order.length) % order.length;
      const item = items[order[pos]];
      counter.textContent = `${pos + 1} / ${order.length}`;
      caption.textContent = clean(item.alt);
      if (item.link) {
        link.hidden = false;
        link.href = item.link.href;
        link.innerHTML = `${item.link.label} ${chevron}`;
      } else {
        link.hidden = true;
      }
      if (item.src) {
        img.classList.remove('hidden');
        ph.classList.add('hidden');
        img.style.animation = 'none';
        img.offsetHeight; // restart the fade-in
        img.style.animation = '';
        img.src = item.src;
        img.alt = item.alt;
      } else {
        img.classList.add('hidden');
        ph.classList.remove('hidden');
        ph.textContent = `[${clean(item.alt)}]`;
      }
    };

    openers.forEach((btn) =>
      btn.addEventListener('click', () => {
        opener = btn;
        order = openers.filter((b) => b.offsetParent !== null).map((b) => Number(b.dataset.lightboxOpen));
        show(Math.max(0, order.indexOf(Number(btn.dataset.lightboxOpen))));
        dialog.showModal();
        document.documentElement.style.overflow = 'hidden';
      }),
    );
    dialog.addEventListener('close', () => {
      document.documentElement.style.overflow = '';
      opener?.focus();
    });
    dialog.querySelector('[data-lightbox-close]')?.addEventListener('click', () => dialog.close());
    dialog.querySelector('[data-lightbox-prev]')?.addEventListener('click', () => show(pos - 1));
    dialog.querySelector('[data-lightbox-next]')?.addEventListener('click', () => show(pos + 1));
    // Click on the dark area (not the photo, link or controls) closes
    dialog.addEventListener('click', (e) => {
      const t = e.target as HTMLElement;
      if (!t.closest('img, button, a, [data-lightbox-placeholder]')) dialog.close();
    });
    dialog.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowLeft') show(pos - 1);
      if (e.key === 'ArrowRight') show(pos + 1);
    });
    let startX = 0;
    dialog.addEventListener('touchstart', (e) => { startX = e.touches[0].clientX; }, { passive: true });
    dialog.addEventListener('touchend', (e) => {
      const dx = e.changedTouches[0].clientX - startX;
      if (Math.abs(dx) > 50) show(pos + (dx < 0 ? 1 : -1));
    });
  });
</script>
