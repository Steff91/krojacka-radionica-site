---
import SectionHeading from './SectionHeading.astro';
import { getLang, t } from '../i18n';

interface Props {
  items: { q: string; a: string }[];
  eyebrow?: string;
  title?: string;
}
const ui = t(getLang(Astro.url));
const { items, eyebrow = ui.service.faqEyebrow, title = ui.service.faqTitle } = Astro.props;
---

{items.length > 0 && (
  <section class="border-t border-line py-18 sm:py-28">
    <div class="container-site grid gap-16 lg:grid-cols-[0.8fr_1.2fr]">
      <SectionHeading eyebrow={eyebrow} title={title} />
      <div>
        {items.map((f) => (
          <details class="faq border-t border-line last:border-b" data-faq>
            <summary class="flex min-h-11 cursor-pointer list-none items-center justify-between gap-6 py-6 font-serif text-[22px] font-medium transition-colors duration-300 hover:text-red">
              {f.q}
              <span class="faq-icon relative h-4 w-4 shrink-0" aria-hidden="true"></span>
            </summary>
            <div class="faq-body overflow-hidden">
              <p class="faq-text m-0 pb-6 text-body">{f.a}</p>
            </div>
          </details>
        ))}
      </div>
    </div>
  </section>
)}

<style>
  .faq summary::-webkit-details-marker { display: none; }
  .faq-icon::before, .faq-icon::after {
    content: ''; position: absolute; left: 0; top: 50%; width: 100%; height: 1.5px;
    background: var(--color-red); transition: transform .3s ease;
  }
  .faq-icon::after { transform: rotate(90deg); }
  .faq[open] .faq-icon::after { transform: rotate(0deg); }
  /* Answer text eases in slightly after the panel starts opening */
  .faq-text { transition: opacity .35s ease .08s, transform .4s ease .08s; }
  .faq:not([open]) .faq-text, .faq.is-closing .faq-text { opacity: 0; transform: translateY(-6px); transition-delay: 0s; }
  @media (prefers-reduced-motion: reduce) {
    .faq-icon::before, .faq-icon::after, .faq-text { transition: none; }
  }
</style>

<script>
  // Smooth open/close for <details>: animates the answer's height, then toggles [open].
  // Without JS (or with reduced motion) the native instant toggle still works.
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)');
  const DURATION = 380;
  const EASING = 'cubic-bezier(.2, .7, .2, 1)';

  document.querySelectorAll<HTMLDetailsElement>('details[data-faq]').forEach((el) => {
    const summary = el.querySelector('summary');
    const body = el.querySelector<HTMLElement>('.faq-body');
    if (!summary || !body) return;
    let anim: Animation | null = null;

    const run = (from: number, to: number, done: () => void) => {
      anim?.cancel();
      anim = body.animate({ height: [`${from}px`, `${to}px`] }, { duration: DURATION, easing: EASING });
      anim.onfinish = () => { anim = null; done(); };
    };

    summary.addEventListener('click', (e) => {
      if (reduce.matches) return;
      e.preventDefault();
      const current = body.getBoundingClientRect().height;
      if (!el.open || el.classList.contains('is-closing')) {
        el.classList.remove('is-closing');
        el.open = true;
        run(anim ? current : 0, body.scrollHeight, () => {});
      } else {
        el.classList.add('is-closing');
        run(current, 0, () => { el.open = false; el.classList.remove('is-closing'); });
      }
    });
  });
</script>
