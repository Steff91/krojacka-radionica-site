---
// Decorative background: a small repeating tile of sewing motifs — dashed seam lines,
// tailor's chalk crosses, buttons, notches and grainline arrows — kept very faint.
// Place inside a `relative isolate` section. Purely decorative (aria-hidden).
//  - Hero sections: <HeroTexture /> covers the section and fades out towards the bottom.
//  - Other sections: <HeroTexture corner="tr" angle={-12} /> shows only in one corner,
//    fading towards the centre where the text is, optionally at an angle.
interface Props {
  /** light = ivory/sand sections, dark = ink sections */
  tone?: 'light' | 'dark';
  /** Show only in this corner, fading towards the centre */
  corner?: 'tl' | 'tr' | 'bl' | 'br';
  /** Rotate the pattern (degrees) */
  angle?: number;
  /** Kept for compatibility with earlier usage */
  side?: 'left' | 'right';
  compact?: boolean;
  class?: string;
}
const { tone = 'light', corner, angle = 0, class: className = '' } = Astro.props;
const CORNERS = { tl: '0% 0%', tr: '100% 0%', bl: '0% 100%', br: '100% 100%' };
const mask = corner
  ? `radial-gradient(ellipse 55% 75% at ${CORNERS[corner]}, #000 0%, rgba(0,0,0,.5) 45%, transparent 100%)`
  : 'linear-gradient(to bottom, #000 40%, transparent 100%)';

const color = tone === 'dark' ? '#C9A96E' : '#2D2926';
const tile = `
<svg xmlns='http://www.w3.org/2000/svg' width='200' height='200' viewBox='0 0 200 200' fill='none' stroke='${color}' stroke-linecap='round' stroke-linejoin='round'>
  <path d='M-10 52 C30 30 60 74 100 52 S170 30 210 52' stroke-dasharray='5 5' stroke-width='1'/>
  <path d='M-10 152 C30 130 60 174 100 152 S170 130 210 152' stroke-dasharray='5 5' stroke-width='1'/>
  <path d='M30 92 l8 8 M38 92 l-8 8' stroke-width='1.1'/>
  <path d='M132 192 l8 8 M140 192 l-8 8 M132 -8 l8 8 M140 -8 l-8 8' stroke-width='1.1'/>
  <circle cx='150' cy='96' r='6' stroke-width='1'/>
  <circle cx='148' cy='94' r='.8' fill='${color}' stroke='none'/><circle cx='152' cy='94' r='.8' fill='${color}' stroke='none'/>
  <circle cx='148' cy='98' r='.8' fill='${color}' stroke='none'/><circle cx='152' cy='98' r='.8' fill='${color}' stroke='none'/>
  <path d='M70 12 l5 8 l5 -8' stroke-width='1'/>
  <path d='M86 112 v26 M83 115 l3 -3 l3 3 M83 135 l3 3 l3 -3' stroke-width='1'/>
</svg>`;
const uri = `url("data:image/svg+xml,${encodeURIComponent(tile.replace(/\s+/g, ' ').trim())}")`;
---

<div
  class:list={['hero-texture pointer-events-none absolute inset-0 -z-10 overflow-hidden', `tone-${tone}`, corner && 'is-corner', className]}
  style={`--tile: ${uri}; --mask: ${mask}; --angle: ${angle}deg`}
  aria-hidden="true"
>
  <div class="tile absolute"></div>
</div>

<style>
  .hero-texture {
    opacity: .07;
    /* Fade out (towards the bottom, or towards the centre for corners) so it never ends on a hard edge */
    -webkit-mask-image: var(--mask);
    mask-image: var(--mask);
  }
  .tone-dark { opacity: .12; }
  /* Corners fade towards the centre, so they start a touch stronger */
  .is-corner { opacity: .09; }
  .is-corner.tone-dark { opacity: .15; }
  /* Oversized so a rotated pattern still covers every corner */
  .tile {
    inset: -50%;
    background-image: var(--tile);
    background-size: 200px 200px;
    transform: rotate(var(--angle));
  }
  @media (max-width: 639px) {
    .tile { background-size: 160px 160px; }
  }
</style>
