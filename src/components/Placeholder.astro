---
import { responsive } from '../lib/responsive';
// Image slot. Pass `src` once real photos exist; until then renders a labelled placeholder.
interface Props {
  label: string;
  src?: string;
  alt?: string;
  class?: string;
  tone?: 'sand' | 'sand-dark' | 'sage' | 'dark';
  /** CSS object-position, e.g. "60% 20%", to keep the subject in frame when cropped */
  position?: string;
  /** Load immediately (above-the-fold images such as the hero) */
  eager?: boolean;
  /** Square corners (when a parent already clips to a rounded shape) */
  square?: boolean;
  /** Rendered width hint for the browser's srcset choice */
  sizes?: string;
}
const { label, src, alt = '', class: className = '', tone = 'sand', position = 'center', eager = false, square = false, sizes = '(min-width: 1024px) 50vw, 100vw' } = Astro.props;
const r = await responsive(src);
// isolate keeps the rounded clip while the image scales on hover (Safari)
const shape = square ? '' : 'rounded-media isolate';
const tones = {
  sand: '',
  'sand-dark': '!bg-sand-dark',
  sage: '!bg-sage !text-ink',
  dark: '!bg-ink-soft !text-on-dark-muted',
};
---

{src ? (
  <div class:list={['overflow-hidden', shape, className]}>
    <img
      src={src}
      srcset={r?.srcset}
      sizes={r ? sizes : undefined}
      width={r?.width}
      height={r?.height}
      alt={alt}
      loading={eager ? 'eager' : 'lazy'}
      fetchpriority={eager ? 'high' : undefined}
      style={`object-position: ${position}`}
      class="h-full w-full object-cover transition-transform duration-700 ease-out hover:scale-[1.03]"
    />
  </div>
) : (
  <div class:list={['placeholder', shape, tones[tone], className]}>[{label}]</div>
)}
