---
// Google Maps without an API key (plain embed URL in info.json → mapsEmbed).
// loading="lazy": the map is fetched only when it scrolls into view.
import info from '../data/info.json';

interface Props {
  class?: string;
}
const { class: className = '' } = Astro.props;
---

{info.mapsEmbed && (
  <div class:list={['relative overflow-hidden bg-sand', className]}>
    <iframe
      src={info.mapsEmbed}
      title="Mapa — lokacija krojačke radionice"
      loading="lazy"
      referrerpolicy="no-referrer-when-downgrade"
      allowfullscreen
      class="absolute inset-0 h-full w-full border-0 [filter:grayscale(.35)_sepia(.08)]"
    ></iframe>
  </div>
)}
