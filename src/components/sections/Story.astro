---
import SectionHeading from '../SectionHeading.astro';
import Placeholder from '../Placeholder.astro';
import Icon from '../Icon.astro';
import { getLang, route, t } from '../../i18n';
const lang = getLang(Astro.url);
const ui = t(lang);
---

<section id="prica" class="py-18 sm:py-30">
  <div class="container-site grid items-center gap-16 lg:grid-cols-[0.9fr_1.1fr]">
    <SectionHeading
      eyebrow={ui.home.storyEyebrow}
      title={ui.home.storyTitle}
      titleEm={ui.home.storyTitleEm}
      text={ui.home.storyText}
    >
      <a href={route(lang, 'about')} class="link-arrow mt-4 self-start" data-reveal style="--i:3">{ui.home.storyLink}<Icon name="chevron-right" size={12} class="chev" /></a>
    </SectionHeading>
    <Placeholder label={ui.home.storyImage} class="h-[420px] sm:h-[560px]" />
  </div>
</section>
