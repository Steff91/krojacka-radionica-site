---
import HeroTexture from '../HeroTexture.astro';
import SectionHeading from '../SectionHeading.astro';
import { getLang, getData, t } from '../../i18n';
const lang = getLang(Astro.url);
const ui = t(lang);
const process = getData(lang).process;
---

<section class="relative isolate overflow-hidden bg-sand py-18 sm:py-28">
  <HeroTexture corner="tr" angle={-14} />
  <div class="container-site flex flex-col gap-14">
    <SectionHeading
      eyebrow={ui.process.eyebrow}
      title={ui.process.title}
      text={ui.process.text}
    />
    <ol class="m-0 grid list-none grid-cols-[repeat(auto-fit,minmax(240px,1fr))] gap-10 p-0">
      {process.steps.map((step, i) => (
        <li class="flex flex-col gap-3 border-t border-gold pt-6" data-reveal style={`--i:${i}`}>
          <span class="font-serif text-[56px] leading-none text-red italic">{String(i + 1).padStart(2, '0')}</span>
          <h3 class="h-card">{step.title}</h3>
          <p class="m-0 text-base text-body">{step.text}</p>
        </li>
      ))}
    </ol>
  </div>
</section>
