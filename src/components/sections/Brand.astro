---
import HeroTexture from '../HeroTexture.astro';
import SectionHeading from '../SectionHeading.astro';
import Placeholder from '../Placeholder.astro';
import { getLang, getServices, bookingUrl, t } from '../../i18n';

const lang = getLang(Astro.url);
const ui = t(lang);
const brand = (await getServices(lang)).find((s) => s.data.variant === 'featured');
---

{brand && (
  <section id="brend" class="relative isolate overflow-hidden bg-ink py-18 text-on-dark sm:py-30">
    <HeroTexture tone="dark" corner="br" angle={18} />
    <div class="container-site grid items-center gap-16 lg:grid-cols-2">
      <Placeholder label={brand.data.imageLabel} src={brand.data.image} alt={brand.data.title} tone="dark" class="h-[360px] sm:h-[480px]" />
      <SectionHeading
        eyebrow={ui.nav.forDesigners}
        title={brand.data.heroTitle}
        titleEm={brand.data.heroTitleEm}
        text={brand.data.excerpt}
        dark
      >
        <div class="mt-8" data-reveal style="--i:3">
          <a href={bookingUrl(lang, brand.key)} class="btn btn-gold">{ui.cta.book}</a>
        </div>
      </SectionHeading>
    </div>
  </section>
)}
