---
import { getCollection } from 'astro:content';
import SectionHeading from '../SectionHeading.astro';
import Icon from '../Icon.astro';
import info from '../../data/info.json';
import { getLang, t } from '../../i18n';
import raw from '../../content/testimonials.json';

// Keep the order from testimonials.json (the collection itself is unordered).
const ui = t(getLang(Astro.url));
const order = raw.map((r) => r.id);
const items = (await getCollection('testimonials'))
  .filter((t) => t.data.featured)
  .sort((a, b) => order.indexOf(a.id) - order.indexOf(b.id))
  .slice(0, 3);

const initials = (name: string) => name.split(/\s+/).map((w) => w[0]).slice(0, 2).join('').toUpperCase();
const avatarTones = ['bg-sage text-ivory', 'bg-gold text-ink', 'bg-red text-ivory'];
---

<section class="bg-sage-light py-18 sm:py-28">
  <div class="container-site flex flex-col gap-14">
    <SectionHeading
      eyebrow={ui.testimonials.eyebrow}
      title={ui.testimonials.title}
      text={ui.testimonials.text}
    />
    <!-- Chat-style reviews: avatar + name above a speech bubble whose corner points back at the author -->
    <div class="grid items-start gap-x-6 gap-y-10 md:grid-cols-2 lg:grid-cols-3">
      {items.map((t, i) => (
        <figure class:list={['m-0 flex flex-col gap-3', i === 1 && 'lg:mt-14', i === 2 && 'lg:mt-6']} data-reveal style={`--i:${i}`}>
          <figcaption class="flex items-center gap-3">
            <span class:list={['inline-flex h-11 w-11 shrink-0 items-center justify-center rounded-full font-sans text-[15px] font-medium', avatarTones[i % avatarTones.length]]} aria-hidden="true">{initials(t.data.name)}</span>
            <span class="flex flex-col leading-tight">
              <span class="text-[15px] font-medium text-ink">{t.data.name}</span>
              <span class="text-[13px] text-muted">Google</span>
            </span>
          </figcaption>
          <div class="bubble relative ml-5 rounded-bubble rounded-tl-md bg-ivory px-6 py-5 shadow-[0_18px_40px_-24px_rgba(45,41,38,0.35)] sm:px-7 sm:py-6">
            <blockquote lang="sr-Latn" class="m-0 text-[16px] leading-[1.7] text-ink">{t.data.text}</blockquote>
            <span class="mt-4 inline-flex gap-1 text-gold" role="img" aria-label={ui.testimonials.rating(t.data.rating)}>
              {Array.from({ length: 5 }, (_, n) => (
                <Icon name="star" size={13} class={n < t.data.rating ? '' : 'opacity-25'} />
              ))}
            </span>
          </div>
        </figure>
      ))}
    </div>

    <div class="flex flex-wrap items-center justify-between gap-x-8 gap-y-6 rounded-media bg-ivory/70 p-5 sm:rounded-full sm:py-4 sm:pr-4 sm:pl-8" data-reveal>
      {info.googleRating && (
        <a href={info.googleReviews} target="_blank" rel="noopener" class="flex items-center gap-4 no-underline hover:text-ink">
          <span class="font-serif text-[44px] leading-none">{info.googleRating}</span>
          <span class="flex flex-col gap-1">
            <span class="inline-flex gap-1 text-gold" aria-hidden="true">
              {Array.from({ length: 5 }, () => <Icon name="star" size={14} />)}
            </span>
            <span class="text-sm text-body underline">{ui.testimonials.onGoogle(info.googleReviewCount)}</span>
          </span>
        </a>
      )}
      <div class="flex flex-wrap gap-4">
        {info.googleReviews && (
          <a href={info.googleReviews} class="btn btn-outline" target="_blank" rel="noopener">
            {ui.testimonials.all}<Icon name="chevron-right" size={11} class="chev" />
          </a>
        )}
        {info.googleWriteReview && (
          <a href={info.googleWriteReview} class="btn btn-dark" target="_blank" rel="noopener">
            {ui.testimonials.write}<Icon name="chevron-right" size={11} class="chev" />
          </a>
        )}
      </div>
    </div>
  </div>
</section>

<style>
  /* Small tail at the bubble's top-left corner, pointing up at the avatar */
  .bubble::before {
    content: ''; position: absolute; top: -9px; left: 0;
    width: 18px; height: 10px; background: var(--color-ivory);
    clip-path: polygon(0 100%, 0 0, 100% 100%);
  }
  .btn .chev { transition: transform .3s ease; }
  .btn:hover .chev { transform: translateX(4px); }
</style>
