---
import GallerySlider from '../GallerySlider.astro';
import Icon from '../Icon.astro';
import info from '../../data/info.json';
import work from '../../data/work.json';
---

<GallerySlider
  id="radovi"
  eyebrow="Naš rad"
  title="Izabrani radovi"
  text="Svaki komad koji izlazi iz naše radionice nosi istu pažnju — bilo da je u pitanju venčanica, pozorišni kostim ili muški kaput. Pogledajte neke od radova na koje smo posebno ponosni."
  items={work.items}
>
  <a href={info.instagram} class="link-arrow self-start" rel="noopener">Pratite nas na Instagramu · {info.instagramHandle}<Icon name="chevron-right" size={12} class="chev" /></a>
</GallerySlider>
