---
import SectionHeading from '../SectionHeading.astro';
import Placeholder from '../Placeholder.astro';
import Icon from '../Icon.astro';
import info from '../../data/info.json';
import work from '../../data/work.json';

type Item = { src?: string; alt: string };
const items: Item[] = work.items;
const tones = ['sand', 'sand-dark'] as const;
---

<section id="radovi" class="overflow-x-clip py-18 sm:py-28">
  <div class="container-site flex flex-col gap-12">
    <div class="flex flex-wrap items-end justify-between gap-8 lg:flex-nowrap">
      <SectionHeading
        class="min-w-0"
        eyebrow="Naš rad"
        title="Izabrani radovi"
        text="Svaki komad koji izlazi iz naše radionice nosi istu pažnju — bilo da je u pitanju venčanica, pozorišni kostim ili muški kaput. Pogledajte neke od radova na koje smo posebno ponosni."
      />
      <div class="flex shrink-0 items-center gap-3">
        <button type="button" class="slider-btn" data-slider-prev aria-label="Prethodni radovi" aria-controls="work-track">
          <Icon name="chevron-right" size={14} class="rotate-180" />
        </button>
        <button type="button" class="slider-btn" data-slider-next aria-label="Sledeći radovi" aria-controls="work-track">
          <Icon name="chevron-right" size={14} />
        </button>
      </div>
    </div>

    <div class="relative">
      <ul id="work-track" class="work-track m-0 flex list-none gap-3 overflow-x-auto p-0" aria-label="Izabrani radovi">
        {items.map((item, i) => (
          <li class="work-slide shrink-0">
            <button
              type="button"
              class="group block w-full cursor-zoom-in border-0 bg-transparent p-0 text-left"
              data-lightbox-open={i}
              aria-label={`Uvećaj fotografiju: ${item.alt.replace(/[[\]]/g, '')}`}
            >
              <Placeholder label={item.alt.replace(/[[\]]/g, '')} src={item.src} alt={item.alt} tone={tones[i % 2]} class="aspect-[4/5]" />
            </button>
          </li>
        ))}
      </ul>
      <div class="mt-6 h-px w-full bg-line" aria-hidden="true">
        <div class="work-progress h-px bg-red" data-slider-progress></div>
      </div>
    </div>

    <a href={info.instagram} class="link-arrow self-start" rel="noopener">Pratite nas na Instagramu · {info.instagramHandle}<Icon name="chevron-right" size={12} class="chev" /></a>
  </div>

  <!-- Lightbox -->
  <dialog id="lightbox" class="lightbox" aria-label="Pregled fotografija">
    <div class="flex h-full w-full flex-col">
      <div class="flex items-center justify-between px-4 py-4 text-on-dark sm:px-8">
        <span class="text-sm tracking-[0.12em]" data-lightbox-counter></span>
        <button type="button" class="lb-btn" data-lightbox-close aria-label="Zatvori">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="M5 5l14 14M19 5L5 19"></path></svg>
        </button>
      </div>
      <div class="relative flex min-h-0 flex-1 items-center justify-center px-4 pb-6 sm:px-24">
        <button type="button" class="lb-btn lb-nav left-3 sm:left-8" data-lightbox-prev aria-label="Prethodna fotografija">
          <Icon name="chevron-right" size={16} class="rotate-180" />
        </button>
        <figure class="m-0 flex h-full max-h-full w-full flex-col items-center justify-center gap-4">
          <img data-lightbox-img alt="" class="lb-img hidden max-h-[calc(100%-3rem)] max-w-full object-contain" />
          <div data-lightbox-placeholder class="placeholder hidden aspect-[4/5] h-[60vh] max-w-full !bg-ink-soft !text-on-dark-muted"></div>
          <figcaption class="text-center text-sm text-on-dark-muted" data-lightbox-caption></figcaption>
        </figure>
        <button type="button" class="lb-btn lb-nav right-3 sm:right-8" data-lightbox-next aria-label="Sledeća fotografija">
          <Icon name="chevron-right" size={16} />
        </button>
      </div>
    </div>
  </dialog>

  <script type="application/json" id="work-data" set:html={JSON.stringify(items)} />
</section>

<style>
  .work-track {
    scroll-snap-type: x mandatory;
    scroll-behavior: smooth;
    scrollbar-width: none;
    overscroll-behavior-x: contain;
  }
  .work-track::-webkit-scrollbar { display: none; }
  .work-slide { scroll-snap-align: start; width: 72%; }
  @media (min-width: 640px) { .work-slide { width: calc((100% - 24px) / 3); } }
  @media (min-width: 1024px) { .work-slide { width: calc((100% - 36px) / 4); } }

  .work-progress { width: 25%; transition: width .4s ease, margin-left .4s ease; }

  .slider-btn {
    display: inline-flex; align-items: center; justify-content: center;
    width: 48px; height: 48px; border-radius: 4px; cursor: pointer;
    border: 1px solid var(--color-ink); background: transparent; color: var(--color-ink);
    transition: background-color .3s ease, color .3s ease, opacity .3s ease;
  }
  .slider-btn:hover:not(:disabled) { background: var(--color-ink); color: var(--color-on-dark); }
  .slider-btn:disabled { opacity: .3; cursor: default; }

  .lightbox {
    width: 100vw; height: 100dvh; max-width: none; max-height: none;
    margin: 0; padding: 0; border: 0;
    background: var(--color-ink);
  }
  .lightbox::backdrop { background: var(--color-ink); }
  .lightbox[open] { animation: lb-in .3s ease; }
  @keyframes lb-in { from { opacity: 0; } to { opacity: 1; } }
  .lb-img { animation: lb-img-in .35s ease; }
  @keyframes lb-img-in { from { opacity: 0; transform: scale(.98); } to { opacity: 1; transform: none; } }

  .lb-btn {
    display: inline-flex; align-items: center; justify-content: center;
    width: 48px; height: 48px; border-radius: 4px; cursor: pointer;
    border: 1px solid var(--color-line-dark); background: rgba(45, 41, 38, .6); color: var(--color-on-dark);
    transition: border-color .3s ease, color .3s ease;
  }
  .lb-btn:hover { border-color: var(--color-gold); color: var(--color-gold); }
  .lb-nav { position: absolute; top: 50%; transform: translateY(-50%); z-index: 1; }
  /* Phones: arrows sit below the photo instead of covering it */
  @media (max-width: 639px) {
    .lb-nav { top: auto; bottom: 16px; transform: none; }
    .lightbox figure { padding-bottom: 64px; }
  }

  @media (prefers-reduced-motion: reduce) {
    .work-track { scroll-behavior: auto; }
    .lightbox[open], .lb-img { animation: none; }
  }
</style>

<script>
  type Item = { src?: string; alt: string };
  const items: Item[] = JSON.parse(document.getElementById('work-data')?.textContent ?? '[]');
  const clean = (s: string) => s.replace(/[[\]]/g, '');

  // --- Slider ---
  const track = document.getElementById('work-track');
  const prev = document.querySelector<HTMLButtonElement>('[data-slider-prev]');
  const next = document.querySelector<HTMLButtonElement>('[data-slider-next]');
  const progress = document.querySelector<HTMLElement>('[data-slider-progress]');

  const step = () => {
    const slide = track?.querySelector<HTMLElement>('.work-slide');
    return slide ? slide.offsetWidth + 12 : 300;
  };
  const update = () => {
    if (!track) return;
    const max = track.scrollWidth - track.clientWidth;
    const x = track.scrollLeft;
    if (prev) prev.disabled = x <= 2;
    if (next) next.disabled = x >= max - 2;
    if (progress) {
      const visible = track.clientWidth / track.scrollWidth;
      progress.style.width = `${visible * 100}%`;
      progress.style.marginLeft = `${max > 0 ? (x / max) * (1 - visible) * 100 : 0}%`;
    }
  };
  prev?.addEventListener('click', () => track?.scrollBy({ left: -step() }));
  next?.addEventListener('click', () => track?.scrollBy({ left: step() }));
  track?.addEventListener('scroll', () => requestAnimationFrame(update), { passive: true });
  window.addEventListener('resize', update);
  update();

  // --- Lightbox ---
  const dialog = document.getElementById('lightbox') as HTMLDialogElement | null;
  const img = dialog?.querySelector<HTMLImageElement>('[data-lightbox-img]');
  const ph = dialog?.querySelector<HTMLElement>('[data-lightbox-placeholder]');
  const caption = dialog?.querySelector<HTMLElement>('[data-lightbox-caption]');
  const counter = dialog?.querySelector<HTMLElement>('[data-lightbox-counter]');
  let current = 0;
  let opener: HTMLElement | null = null;

  const show = (i: number) => {
    if (!img || !ph || !caption || !counter) return;
    current = (i + items.length) % items.length;
    const item = items[current];
    counter.textContent = `${current + 1} / ${items.length}`;
    caption.textContent = clean(item.alt);
    if (item.src) {
      img.classList.remove('hidden');
      ph.classList.add('hidden');
      // Restart the fade-in animation
      img.style.animation = 'none';
      img.offsetHeight;
      img.style.animation = '';
      img.src = item.src;
      img.alt = item.alt;
    } else {
      img.classList.add('hidden');
      ph.classList.remove('hidden');
      ph.textContent = `[${clean(item.alt)}]`;
    }
  };

  document.querySelectorAll<HTMLElement>('[data-lightbox-open]').forEach((btn) =>
    btn.addEventListener('click', () => {
      opener = btn;
      show(Number(btn.dataset.lightboxOpen));
      dialog?.showModal();
      document.documentElement.style.overflow = 'hidden';
    }),
  );
  dialog?.addEventListener('close', () => {
    document.documentElement.style.overflow = '';
    opener?.focus();
  });
  dialog?.querySelector('[data-lightbox-close]')?.addEventListener('click', () => dialog.close());
  dialog?.querySelector('[data-lightbox-prev]')?.addEventListener('click', () => show(current - 1));
  dialog?.querySelector('[data-lightbox-next]')?.addEventListener('click', () => show(current + 1));
  // Click on the dark area (not the photo or controls) closes
  dialog?.addEventListener('click', (e) => {
    const t = e.target as HTMLElement;
    if (t === dialog || (!t.closest('img, button, [data-lightbox-placeholder]') && t.closest('.lightbox'))) {
      if (!t.closest('button')) dialog.close();
    }
  });
  dialog?.addEventListener('keydown', (e) => {
    if (e.key === 'ArrowLeft') show(current - 1);
    if (e.key === 'ArrowRight') show(current + 1);
  });
  // Swipe on touch screens
  let startX = 0;
  dialog?.addEventListener('touchstart', (e) => { startX = e.touches[0].clientX; }, { passive: true });
  dialog?.addEventListener('touchend', (e) => {
    const dx = e.changedTouches[0].clientX - startX;
    if (Math.abs(dx) > 50) show(current + (dx < 0 ? 1 : -1));
  });
</script>
