---
import GallerySlider from '../GallerySlider.astro';
import Icon from '../Icon.astro';
import info from '../../data/info.json';
import { getLang, getData, route, t } from '../../i18n';
const lang = getLang(Astro.url);
const ui = t(lang);
const work = getData(lang).work;
---

<GallerySlider
  id="radovi"
  eyebrow={ui.home.workEyebrow}
  title={ui.home.workTitle}
  text={ui.home.workText}
  items={work.items}
>
  <div class="flex flex-wrap items-center gap-x-8 gap-y-4">
    <a href={route(lang, 'works')} class="btn btn-outline">{ui.cta.allWorks}<Icon name="chevron-right" size={11} class="chev" /></a>
    <a href={info.instagram} class="link-arrow" rel="noopener">{ui.home.followInstagram} · {info.instagramHandle}<Icon name="chevron-right" size={12} class="chev" /></a>
  </div>
</GallerySlider>
