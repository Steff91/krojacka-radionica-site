---
import HeroTexture from '../HeroTexture.astro';
import Placeholder from '../Placeholder.astro';
import Icon from '../Icon.astro';
import { getLang, getInfo, route, t } from '../../i18n';
const lang = getLang(Astro.url);
const ui = t(lang);
const info = getInfo(lang);
---

<section class="relative isolate overflow-x-clip pt-12 pb-28 sm:pt-16 sm:pb-32">
  <HeroTexture side="left" />
  <div class="container-site grid items-center gap-16 lg:grid-cols-[1.05fr_1fr]">
    <div class="flex flex-col gap-7">
      <p class="eyebrow !mb-0" data-reveal>{ui.hero.eyebrow} · {info.city}</p>
      <h1 class="h-display" data-reveal style="--i:1">{ui.hero.h1} <em class="font-normal text-red">{ui.hero.h1Em}</em></h1>
      <p class="lead max-w-[480px] text-[19px]" data-reveal style="--i:2">
        {ui.hero.lead}
      </p>
      <div class="flex flex-wrap gap-4" data-reveal style="--i:3">
        <a href="#usluge" class="btn btn-dark">{ui.hero.seeServices}</a>
        <a href={route(lang, 'booking')} class="btn btn-outline">{ui.cta.book}</a>
      </div>
    </div>

    <div class="hero-media relative h-[460px] sm:h-[620px]" data-reveal style="--i:2">
      <!-- Offset gold frame behind the main photo -->
      <div class="absolute top-[-12px] right-[-12px] bottom-3 left-[52px] border border-gold rounded-media sm:top-[-20px] sm:right-[-20px] sm:bottom-5 sm:left-[84px]" aria-hidden="true"></div>

      <Placeholder
        label={ui.hero.imageLabel}
        src="/uploads/hero-vencanica.webp"
        alt={ui.hero.imageAlt}
        position="60% 25%"
        eager
        class="absolute inset-y-0 right-0 left-10 shadow-[0_40px_80px_-40px_rgba(45,41,38,0.45)] sm:left-16"
      />

      <div class="hero-detail absolute bottom-12 left-0 z-10">
        <Placeholder
          label={ui.hero.detailLabel}
          src="/uploads/hero-detalj.webp"
          alt={ui.hero.detailAlt}
          position="55% 40%"
          eager
          tone="sage"
          class="h-[200px] w-[170px] border-8 border-ivory shadow-[0_28px_50px_-18px_rgba(45,41,38,0.5)] sm:h-[260px] sm:w-[220px]"
        />
      </div>

      <!-- Rotating badge -->
      <div class="hero-badge absolute top-6 left-0 z-10 h-[92px] w-[92px] sm:top-10 sm:left-2 sm:h-[124px] sm:w-[124px]" aria-hidden="true">
        <div class="absolute inset-0 rounded-full bg-ivory shadow-[0_14px_30px_-12px_rgba(45,41,38,0.35)]"></div>
        <svg viewBox="0 0 120 120" class="badge-ring absolute inset-0 h-full w-full text-ink">
          <defs>
            <path id="badge-circle" d="M60,60 m-44,0 a44,44 0 1,1 88,0 a44,44 0 1,1 -88,0"></path>
          </defs>
          <text font-size="10.5" letter-spacing="2.2" fill="currentColor" font-family="DM Sans, sans-serif" font-weight="500">
            <textPath href="#badge-circle" textLength="270">{ui.hero.badge}</textPath>
          </text>
        </svg>
        <img src="/logo.png" alt="" width="22" height="27" class="absolute top-1/2 left-1/2 w-[22px] -translate-x-1/2 -translate-y-1/2 mix-blend-multiply sm:w-[28px]" />
      </div>
    </div>
  </div>

  <!-- Scroll hint -->
  <a href="#usluge" class="scroll-hint absolute bottom-6 left-1/2 inline-flex h-11 w-11 -translate-x-1/2 items-center justify-center rounded-full border border-line text-ink no-underline transition-colors duration-300 hover:border-red hover:text-red sm:bottom-8" aria-label={ui.hero.scroll}>
    <Icon name="chevron-right" size={12} />
  </a>
</section>

<style>
  .badge-ring { animation: spin 28s linear infinite; }

  /* Gentle nudge downwards; pauses on hover */
  .scroll-hint :global(svg) { transform: rotate(90deg); animation: nudge 2.2s ease-in-out infinite; }
  .scroll-hint:hover :global(svg) { animation-play-state: paused; }
  @keyframes nudge { 0%, 100% { transform: rotate(90deg) translateX(-2px); } 50% { transform: rotate(90deg) translateX(4px); } }
  @keyframes spin { to { transform: rotate(360deg); } }

  /* Detail photo drifts slightly on hover of the composition */
  .hero-detail { transition: transform .6s ease; }
  .hero-media:hover .hero-detail { transform: translateY(-6px); }

  @media (prefers-reduced-motion: reduce) {
    .badge-ring { animation: none; }
    .scroll-hint :global(svg) { animation: none; }
    .hero-detail { transition: none; }
    .hero-media:hover .hero-detail { transform: none; }
  }
</style>
