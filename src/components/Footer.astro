---
import Logo from './Logo.astro';
import Icon from './Icon.astro';
import Social from './Social.astro';
import { getLang, getInfo, getServices, legalUrl, route, t } from '../i18n';
import { getPosts } from '../lib/blog';

const lang = getLang(Astro.url);
const ui = t(lang);
const info = getInfo(lang);
const all = await getServices(lang);
const services = all.filter((s) => s.data.variant === 'default');
const featured = all.find((s) => s.data.variant === 'featured');
// The blog link appears once at least one post is published (not a draft)
const hasPosts = (await getPosts()).length > 0;

const heading = 'mb-2 text-xs font-medium uppercase tracking-[0.22em] text-gold';
const link = 'text-on-dark no-underline hover:text-gold';
const year = new Date().getFullYear();
const ctaHref = route(lang, 'booking');
const legal = {
  imprint: await legalUrl(lang, 'impresum'),
  privacy: await legalUrl(lang, 'privatnost'),
  cookies: await legalUrl(lang, 'kolacici'),
};
---

<footer class="border-t border-line-dark bg-ink text-[15px] text-on-dark-muted">
  <div class="container-site grid grid-cols-[repeat(auto-fit,minmax(220px,1fr))] gap-12 pt-22 pb-16">
    <div class="flex flex-col gap-5">
      <Logo dark stacked />
      <p class="m-0 font-serif text-[22px] italic text-gold">{info.tagline}</p>
      <Social />
    </div>

    <nav aria-label={ui.nav.services} class="flex flex-col gap-2.5">
      <p class={heading}>{ui.nav.services}</p>
      {services.map((s) => <a href={s.url} class={link}>{s.data.title}</a>)}
      {featured && (
        <a href={featured.url} class="group mt-1.5 inline-flex items-center gap-2 text-gold no-underline hover:text-on-dark">
          {featured.data.title}<Icon name="chevron-right" size={11} class="chev" />
        </a>
      )}
    </nav>

    <nav aria-label={ui.nav.workshop} class="flex flex-col gap-2.5">
      <p class={heading}>{ui.nav.workshop}</p>
      <a href={route(lang, 'about')} class={link}>{ui.nav.about}</a>
      <a href={route(lang, 'works')} class={link}>{ui.nav.works}</a>
      {lang === 'sr' && hasPosts && <a href="/blog/" class={link}>{ui.nav.blog}</a>}
      <a href={route(lang, 'contact')} class={link}>{ui.nav.contact}</a>
    </nav>

    <div class="flex flex-col gap-2.5">
      <p class={heading}>{ui.nav.contact}</p>
      <a href={`tel:${info.phoneHref}`} class="font-serif text-2xl text-on-dark no-underline hover:text-gold">{info.phone}</a>
      <a href={info.mapsLink} target="_blank" rel="noopener" class="group inline-flex items-start gap-2.5 text-on-dark-muted no-underline hover:text-gold">
        <Icon name="location" size={15} class="mt-1 text-gold" />
        <span>{info.address}<br />{info.addressNote}, {info.city}</span>
      </a>
      <dl class="m-0 mt-1 grid grid-cols-[auto_1fr] gap-x-4 gap-y-1">
        {info.hours.map((h) => <><dt>{h.day}</dt><dd class="m-0 text-on-dark">{h.time}</dd></>)}
      </dl>
      <a href={ctaHref} class="btn btn-ghost mt-3 self-start">{ui.cta.book}</a>
    </div>
  </div>

  <div class="border-t border-line-dark">
    <div class="container-site flex flex-wrap justify-between gap-4 py-6 text-[13px] text-[#A99E92]">
      <span>© {year} {info.name}. {ui.footer.rights}</span>
      <span class="flex flex-wrap gap-x-6 gap-y-2">
        <a href={legal.imprint} class="text-[#A99E92] hover:text-on-dark">{ui.footer.imprint}</a>
        <a href={legal.privacy} class="text-[#A99E92] hover:text-on-dark">{ui.footer.privacy}</a>
        <a href={legal.cookies} class="text-[#A99E92] hover:text-on-dark">{ui.footer.cookies}</a>
        <a href={legal.cookies} class="text-[#A99E92] hover:text-on-dark" data-open-cookie-settings>{ui.footer.cookieSettings}</a>
      </span>
    </div>
  </div>
</footer>
