---
import { getCollection } from 'astro:content';
import Logo from './Logo.astro';
import Icon from './Icon.astro';
import Social from './Social.astro';
import info from '../data/info.json';

const all = (await getCollection('services')).sort((a, b) => a.data.order - b.data.order);
const services = all.filter((s) => s.data.variant === 'default');
const featured = all.find((s) => s.data.variant === 'featured');

const heading = 'mb-2 text-xs font-medium uppercase tracking-[0.22em] text-gold';
const link = 'text-on-dark no-underline hover:text-gold';
const year = new Date().getFullYear();
---

<footer class="border-t border-line-dark bg-ink text-[15px] text-on-dark-muted">
  <div class="container-site grid grid-cols-[repeat(auto-fit,minmax(220px,1fr))] gap-12 pt-22 pb-16">
    <div class="flex flex-col gap-5">
      <Logo dark stacked />
      <p class="m-0 font-serif text-[22px] italic text-gold">{info.tagline}</p>
      <Social />
    </div>

    <nav aria-label="Usluge" class="flex flex-col gap-2.5">
      <p class={heading}>Usluge</p>
      {services.map((s) => <a href={`/usluge/${s.id}/`} class={link}>{s.data.title}</a>)}
      {featured && (
        <a href={`/usluge/${featured.id}/`} class="group mt-1.5 inline-flex items-center gap-2 text-gold no-underline hover:text-on-dark">
          {featured.data.title}<Icon name="chevron-right" size={11} class="chev" />
        </a>
      )}
    </nav>

    <nav aria-label="Radionica" class="flex flex-col gap-2.5">
      <p class={heading}>Radionica</p>
      <a href="/o-nama/" class={link}>O nama</a>
      <a href="/radovi/" class={link}>Radovi</a>
      <a href="/#kontakt" class={link}>Kontakt</a>
    </nav>

    <div class="flex flex-col gap-2.5">
      <p class={heading}>Kontakt</p>
      <a href={`tel:${info.phoneHref}`} class="font-serif text-2xl text-on-dark no-underline hover:text-gold">{info.phone}</a>
      <a href={info.mapsLink} target="_blank" rel="noopener" class="group inline-flex items-start gap-2.5 text-on-dark-muted no-underline hover:text-gold">
        <Icon name="location" size={15} class="mt-1 text-gold" />
        <span>{info.address}<br />{info.addressNote}, {info.city}</span>
      </a>
      <dl class="m-0 mt-1 grid grid-cols-[auto_1fr] gap-x-4 gap-y-1">
        {info.hours.map((h) => <><dt>{h.day}</dt><dd class="m-0 text-on-dark">{h.time}</dd></>)}
      </dl>
      <a href="/#kontakt" class="btn btn-ghost mt-3 self-start">Zakažite konsultaciju</a>
    </div>
  </div>

  <div class="border-t border-line-dark">
    <div class="container-site flex flex-wrap justify-between gap-4 py-6 text-[13px] text-[#A99E92]">
      <span>© {year} {info.name}. Sva prava zadržana.</span>
      <span class="flex gap-6">
        <a href="/privatnost/" class="text-[#A99E92] hover:text-on-dark">Politika privatnosti</a>
        <a href="/kolacici/" class="text-[#A99E92] hover:text-on-dark">Kolačići</a>
      </span>
    </div>
  </div>
</footer>
