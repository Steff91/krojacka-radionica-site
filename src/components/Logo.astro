---
import info from '../data/info.json';
import { getLang, route } from '../i18n';

interface Props {
  dark?: boolean;
  stacked?: boolean;
}
const { dark = false, stacked = false } = Astro.props;
// /logo.png is trimmed to the artwork (no built-in whitespace) so it aligns with the content edge.
// TODO: replace with an SVG version of the logo when available
const home = route(getLang(Astro.url), 'home');
---

<a href={home} class:list={['flex items-center gap-3.5 no-underline', dark ? 'text-on-dark hover:text-on-dark' : 'text-ink hover:text-ink']}>
  <img
    src="/logo-sm.webp"
    alt=""
    width={stacked ? 46 : 36}
    height={stacked ? 58 : 45}
    class:list={[dark ? 'invert mix-blend-screen' : 'mix-blend-multiply']}
  />
  <span class:list={['font-serif font-medium uppercase leading-[1.1] tracking-[0.04em]', !stacked && 'whitespace-nowrap', stacked ? 'text-2xl' : 'text-xl sm:text-[22px]']}>
    {stacked ? <>Krojačka<br />radionica</> : info.name}
  </span>
</a>
