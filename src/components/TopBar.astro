---
import Icon from './Icon.astro';
import LangSwitch from './LangSwitch.astro';
import { getLang, getInfo, route, t, type Alternates } from '../i18n';

interface Props {
  alternates?: Alternates;
}
const { alternates } = Astro.props;
const lang = getLang(Astro.url);
const ui = t(lang);
const info = getInfo(lang);

// Email icon falls back to the contact page until a real address is set in info.json
const hasEmail = info.email.includes('@');
const mail = hasEmail ? `mailto:${info.email}` : route(lang, 'contact');
const open = info.hours.filter((h) => !('closed' in h && h.closed)).map((h) => `${h.day} ${h.time}`);
// Phones show only the first line (weekdays) so the language switch fits next to it
const [hoursFirst, ...hoursRest] = open;

const links = [
  { icon: 'instagram', label: 'Instagram', href: info.instagram, external: true },
  { icon: 'pinterest', label: 'Pinterest', href: info.pinterest, external: true },
  { icon: 'youtube', label: 'YouTube', href: info.youtube, external: true },
].filter((l) => l.href); // empty link in info.json = icon hidden
const icon = 'inline-flex h-9 w-9 items-center justify-center text-ink no-underline transition-colors duration-300 hover:text-red';
---

<div class="bg-sand text-[13px] font-medium text-ink">
  <div class="container-site flex min-h-10 items-center justify-between gap-4">
    <p class="m-0 flex min-w-0 items-center gap-2.5">
      <Icon name="clock" size={13} />
      <span class="hidden sm:inline">{ui.topbar.hours}</span>
      <span class="truncate">{hoursFirst}{hoursRest.map((h) => <span class="hidden sm:inline"> · {h}</span>)}</span>
    </p>
    <ul class="m-0 flex shrink-0 list-none items-center p-0">
      {links.map((l) => (
        <li class="hidden sm:block">
          <a href={l.href} class={icon} aria-label={l.label} title={l.label} target={l.external ? '_blank' : undefined} rel={l.external ? 'noopener' : undefined}>
            <Icon name={l.icon} size={14} />
          </a>
        </li>
      ))}
      <li class="mx-2 hidden h-4 w-px bg-ink/20 sm:block" aria-hidden="true"></li>
      <li>
        <a href={`tel:${info.phoneHref}`} class={icon} aria-label={`${ui.topbar.call} ${info.phone}`} title={info.phone}>
          <Icon name="phone" size={13} />
        </a>
      </li>
      <li>
        <a href={mail} class={icon} aria-label={ui.topbar.email} title={hasEmail ? info.email : ui.topbar.message}>
          <Icon name="envelope" size={14} />
        </a>
      </li>
      <li class="mx-2 h-4 w-px bg-ink/20" aria-hidden="true"></li>
      <li><LangSwitch alternates={alternates} /></li>
    </ul>
  </div>
</div>
