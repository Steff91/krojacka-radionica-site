---
// Services overview: target of the "Services" breadcrumb, and a hub page for SEO.
import Base from '../layouts/Base.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import Services from '../components/sections/Services.astro';
import Brand from '../components/sections/Brand.astro';
import Process from '../components/sections/Process.astro';
import Contact from '../components/sections/Contact.astro';
import { alternatesFor, getLang, t } from '../i18n';

const ui = t(getLang(Astro.url));
const p = ui.servicesPage;
---

<Base title={p.title} description={p.description} alternates={alternatesFor('services')}>
  <section class="pt-12 pb-4 sm:pt-16">
    <div class="container-site flex flex-col gap-5">
      <Breadcrumbs items={[{ label: p.h1 }]} />
      <h1 class="h-display" data-reveal>{p.h1}</h1>
      <p class="lead max-w-[560px] text-[19px]" data-reveal style="--i:1">{p.lead}</p>
    </div>
  </section>
  <Services heading={false} />
  <Brand />
  <Process />
  <Contact service={ui.nav.services} />
</Base>
