---
import HeroTexture from '../components/HeroTexture.astro';
// Service detail page (both languages). The featured service (fashion brand development) uses BrandView.
import Base from '../layouts/Base.astro';
import Placeholder from '../components/Placeholder.astro';
import SectionHeading from '../components/SectionHeading.astro';
import GallerySlider from '../components/GallerySlider.astro';
import Process from '../components/sections/Process.astro';
import Contact from '../components/sections/Contact.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import Faq from '../components/Faq.astro';
import Icon from '../components/Icon.astro';
import { bookingUrl, route, serviceAlternates, t, type Service } from '../i18n';

interface Props {
  service: Service;
}
const { service } = Astro.props;
const lang = service.lang;
const ui = t(lang);
const alternates = await serviceAlternates(service.key);
const d = service.data;
const featured = d.variant === 'featured';
const shadow = 'shadow-[0_40px_80px_-40px_rgba(45,41,38,0.45)]';

const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'Service',
    name: d.title,
    description: d.seoDescription ?? d.excerpt,
    areaServed: ui.service.areaServed,
    provider: { '@id': new URL('/#radionica', Astro.site).toString() },
  },
  ...(d.faq.length > 0
    ? [{
        '@context': 'https://schema.org',
        '@type': 'FAQPage',
        mainEntity: d.faq
          .filter((f) => !f.a.startsWith('['))
          .map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
      }].filter((s) => s.mainEntity.length > 0)
    : []),
];
---

<Base title={d.seoTitle ?? `${d.title} ${ui.service.seoSuffix}`} description={d.seoDescription ?? d.excerpt} schema={schema} alternates={alternates}>
  <!-- Hero -->
  <section class:list={['relative isolate overflow-x-clip py-16 sm:py-24', featured && 'bg-ink text-on-dark']}>
    <HeroTexture tone={featured ? 'dark' : 'light'} side="left" />
    <div class="container-site grid items-center gap-16 lg:grid-cols-[1.05fr_1fr]">
      <div class="flex flex-col gap-6">
        <Breadcrumbs items={[{ label: ui.nav.services, href: route(lang, 'services') }, { label: d.title }]} dark={featured} />
        <p class:list={['eyebrow !mb-0', featured && '!text-gold']} data-reveal>{featured ? ui.nav.forDesigners : ui.service.eyebrow}</p>
        <h1 class="h-display" data-reveal style="--i:1">
          {d.heroTitle}{d.heroTitleEm && <> <em class:list={['font-normal', featured ? 'text-gold' : 'text-red']}>{d.heroTitleEm}</em></>}
        </h1>
        <p class:list={['lead max-w-[520px] text-[19px]', featured && '!text-[#D9D0C5]']} data-reveal style="--i:2">{d.intro}</p>
        <div data-reveal style="--i:3">
          <a href={bookingUrl(lang, service.key)} class:list={['btn', featured ? 'btn-gold' : 'btn-dark']}>{ui.cta.book}</a>
        </div>
      </div>
      <div class="relative" data-reveal style="--i:2">
        <div class="absolute top-[-12px] right-[-12px] bottom-3 left-3 border border-gold rounded-media sm:top-[-20px] sm:right-[-20px] sm:bottom-5 sm:left-5" aria-hidden="true"></div>
        <Placeholder label={d.imageLabel} src={d.image} alt={d.title} eager tone={featured ? 'dark' : 'sand'} class:list={['relative aspect-[4/5] lg:aspect-auto lg:h-[600px]', shadow]} />
      </div>
    </div>
  </section>

  <!-- What we make -->
  {d.items.length > 0 && (
    <section class="border-t border-line py-18 sm:py-28">
      <div class="container-site flex flex-col gap-14">
        <SectionHeading eyebrow={d.itemsEyebrow ?? ui.service.itemsEyebrow} title={d.itemsTitle ?? d.title} />
        <ul class="m-0 grid list-none gap-4 p-0 sm:grid-cols-2 lg:grid-cols-3">
          {d.items.map((item, i) => (
            <li class="item-card flex flex-col gap-3 rounded-media border border-line bg-ivory p-8 sm:p-10" data-reveal style={`--i:${i % 3}`}>
              <span class="font-serif text-lg leading-none text-red italic">{String(i + 1).padStart(2, '0')}</span>
              <h3 class="h-card mt-2">{item.title}</h3>
              <p class="m-0 text-base text-body">{item.text}</p>
            </li>
          ))}
        </ul>
      </div>
    </section>
  )}

  <!-- Gallery -->
  {d.gallery.length > 0 && (
    <GallerySlider id="galerija" class="border-t border-line" eyebrow={ui.service.galleryEyebrow} title={d.galleryTitle ?? ui.service.galleryTitle} items={d.gallery}>
      {d.gallery.some((g) => g.src) && <a href={`${route(lang, 'works')}#${service.key}`} class="link-arrow self-start">{ui.cta.moreWorks}<Icon name="chevron-right" size={12} class="chev" /></a>}
    </GallerySlider>
  )}

  <Process />

  <Faq items={d.faq} />

  <Contact service={d.title} />
</Base>

<style>
  .item-card { transition: background-color .4s ease; }
  .item-card:hover { background-color: var(--color-sand); }

  @media (prefers-reduced-motion: reduce) {
    .item-card { transition: none; }
  }
</style>
