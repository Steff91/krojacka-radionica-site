---
import HeroTexture from '../components/HeroTexture.astro';
// All real photos from every service gallery (src/lib/works.ts), filterable by category.
// Filter state lives in the URL hash, so service pages can link to /radovi/#<service-key> (or /en/work/#<service-key>).
import Base from '../layouts/Base.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import Lightbox from '../components/Lightbox.astro';
import Icon from '../components/Icon.astro';
import Contact from '../components/sections/Contact.astro';
import info from '../data/info.json';
import { getWorks } from '../lib/works';
import { responsive } from '../lib/responsive';
import { alternatesFor, getLang, t } from '../i18n';

const lang = getLang(Astro.url);
const ui = t(lang);
const { works, categories } = await getWorks(lang);
// Masonry fills columns top to bottom, so the first photo of each column is above the fold (2 or 3 columns)
const n = works.length;
const tops = new Set([0, 1, Math.ceil(n / 2), Math.ceil(n / 2) + 1, Math.ceil(n / 3), Math.ceil((2 * n) / 3)]);
const first = new Set([0, Math.ceil(n / 2)]);
const srcsets = new Map(await Promise.all(works.map(async (w) => [w.src, (await responsive(w.src))?.srcset] as const)));
const lightboxItems = works.map((w) => ({
  src: w.src,
  alt: w.alt,
  link: { href: w.categories[0].href, label: `${ui.works.viewService}: ${w.categories[0].label}` },
}));
---

<Base title={ui.works.title} description={ui.works.description} alternates={alternatesFor('works')}>
  <section class="relative isolate overflow-hidden pt-12 pb-10 sm:pt-16">
    <HeroTexture side="right" compact />
    <div class="container-site flex flex-col gap-5">
      <Breadcrumbs items={[{ label: ui.works.h1 }]} />
      <h1 class="h-display" data-reveal>{ui.works.h1}</h1>
      <p class="lead max-w-[600px] text-[19px]" data-reveal style="--i:1">
        {ui.works.lead}
      </p>
    </div>
  </section>

  <section class="pb-18 sm:pb-28" data-lightbox-root data-works>
    <div class="container-site flex flex-col gap-10">
      <!-- Filter -->
      <div class="filter-bar -mx-4 overflow-x-auto px-4 sm:mx-0 sm:px-0" role="group" aria-label={ui.works.filter}>
        <div class="flex w-max gap-2 sm:w-auto sm:flex-wrap">
          <button type="button" class="chip" data-filter="sve" aria-pressed="true">{ui.works.all} <span class="chip-count">{works.length}</span></button>
          {categories.map((c) => (
            <button type="button" class="chip" data-filter={c.id} aria-pressed="false">{c.label} <span class="chip-count">{c.count}</span></button>
          ))}
        </div>
      </div>

      <!-- Masonry -->
      <ul class="masonry m-0 list-none p-0">
        {works.map((w, i) => (
          <li class="masonry-item mb-4 break-inside-avoid" data-cats={w.categories.map((c) => c.id).join(' ')}>
            <button type="button" class="work group relative isolate block w-full cursor-zoom-in overflow-hidden rounded-card border-0 bg-sand p-0 text-left" data-lightbox-open={i} aria-label={`${ui.gallery.zoom}: ${w.alt}`}>
              <img src={w.src} srcset={srcsets.get(w.src)} sizes="(min-width: 768px) 33vw, 50vw" alt={w.alt} width={w.width} height={w.height} loading={tops.has(i) ? 'eager' : 'lazy'} fetchpriority={first.has(i) ? 'high' : undefined} class="work-img block h-auto w-full" />
              <span class="work-veil pointer-events-none absolute inset-0" aria-hidden="true"></span>
              <span class="work-caption pointer-events-none absolute inset-x-0 bottom-0 flex flex-col gap-1 p-5 text-ivory" aria-hidden="true">
                <span class="text-[12px] font-medium uppercase tracking-[0.22em] text-gold">{w.categories.map((c) => c.label).join(' · ')}</span>
                <span class="text-[15px] leading-snug">{w.alt}</span>
              </span>
            </button>
          </li>
        ))}
      </ul>
      <p class="hidden text-body" data-works-empty>{ui.works.empty}</p>
    </div>

    <Lightbox />
    <script type="application/json" data-lightbox-items set:html={JSON.stringify(lightboxItems)} />
  </section>

  <!-- Instagram band -->
  <section class="bg-ink py-14 text-on-dark sm:py-16">
    <div class="container-site flex flex-wrap items-center justify-between gap-6">
      <div>
        <p class="eyebrow !text-gold">Instagram</p>
        <p class="m-0 font-serif text-[28px] leading-tight uppercase tracking-[0.03em] sm:text-[34px]">{ui.works.instagramTitle} <em class="font-normal text-gold">{ui.works.instagramTitleEm}</em></p>
      </div>
      <a href={info.instagram} target="_blank" rel="noopener" class="btn btn-gold">
        <Icon name="instagram" size={16} />{info.instagramHandle}
      </a>
    </div>
  </section>

  <Contact service={ui.nav.works} tone="ivory" />
</Base>

<style>
  .masonry { columns: 2; column-gap: 12px; }
  @media (min-width: 768px) { .masonry { columns: 3; column-gap: 16px; } }
  .masonry-item { break-inside: avoid; }
  .masonry-item[hidden] { display: none; }

  .filter-bar { scrollbar-width: none; }
  .filter-bar::-webkit-scrollbar { display: none; }
  .chip {
    display: inline-flex; align-items: center; gap: 8px; min-height: 44px; padding: 0 18px;
    border: 1px solid var(--color-line); border-radius: var(--radius-btn); background: transparent; cursor: pointer;
    font: 500 13px/1 var(--font-sans); letter-spacing: .1em; text-transform: uppercase; color: var(--color-ink);
    white-space: nowrap; transition: background-color .3s ease, color .3s ease, border-color .3s ease;
  }
  .chip:hover { border-color: var(--color-wine); }
  .chip[aria-pressed='true'] { background: var(--color-red); border-color: var(--color-red); color: var(--color-ivory); }
  .chip-count { font-size: 11px; color: var(--color-red); }
  .chip[aria-pressed='true'] .chip-count { color: var(--color-sand); }

  .work-img { transition: transform .9s cubic-bezier(.2, .7, .2, 1); }
  .work-veil {
    background: linear-gradient(to top, rgba(45, 41, 38, .75), rgba(45, 41, 38, 0) 55%);
    opacity: 0; transition: opacity .5s ease;
  }
  .work-caption { opacity: 0; transform: translateY(10px); transition: opacity .4s ease, transform .5s cubic-bezier(.2, .7, .2, 1); }
  .work:hover .work-img, .work:focus-visible .work-img { transform: scale(1.04); }
  .work:hover .work-veil, .work:focus-visible .work-veil { opacity: 1; }
  .work:hover .work-caption, .work:focus-visible .work-caption { opacity: 1; transform: none; transition-delay: .06s; }
  /* Touch screens have no hover: keep the category visible */
  @media (hover: none) {
    .work-veil { opacity: .8; }
    .work-caption { opacity: 1; transform: none; }
    .work-caption span:last-child { display: none; }
  }
  @media (prefers-reduced-motion: reduce) {
    .chip, .work-img, .work-veil, .work-caption { transition: none; }
  }
</style>

<script>
  const root = document.querySelector<HTMLElement>('[data-works]');
  const chips = [...(root?.querySelectorAll<HTMLButtonElement>('[data-filter]') ?? [])];
  const items = [...(root?.querySelectorAll<HTMLElement>('.masonry-item') ?? [])];
  const empty = root?.querySelector<HTMLElement>('[data-works-empty]');
  const valid = new Set(chips.map((c) => c.dataset.filter));

  const grid = root?.querySelector<HTMLElement>('.masonry');
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)');
  let current = '';
  let busy: Animation | null = null;

  const apply = (filter: string, animate = false) => {
    if (!valid.has(filter)) filter = 'sve';
    if (filter === current) return;
    current = filter;
    chips.forEach((c) => c.setAttribute('aria-pressed', String(c.dataset.filter === filter)));

    const swap = () => {
      let shown = 0;
      items.forEach((li) => {
        const show = filter === 'sve' || (li.dataset.cats ?? '').split(' ').includes(filter);
        li.hidden = !show;
        if (show) shown++;
      });
      empty?.classList.toggle('hidden', shown > 0);
      if (!animate) return;
      if (grid) grid.style.opacity = '';
      // Photos rise and fade in one after another
      items.filter((li) => !li.hidden).forEach((li, i) => {
        li.animate(
          [{ opacity: 0, transform: 'translateY(14px) scale(.985)' }, { opacity: 1, transform: 'none' }],
          { duration: 480, delay: Math.min(i, 10) * 45, easing: 'cubic-bezier(.2, .7, .2, 1)', fill: 'backwards' },
        );
      });
    };

    if (!animate || reduce.matches || !grid) return swap();
    // Quick fade-out of the current set, then swap and bring the new set in
    busy?.cancel();
    busy = grid.animate([{ opacity: 1 }, { opacity: 0 }], { duration: 160, easing: 'ease-out', fill: 'forwards' });
    busy.onfinish = () => { busy?.cancel(); busy = null; swap(); };
  };

  chips.forEach((c) =>
    c.addEventListener('click', () => {
      const f = c.dataset.filter ?? 'sve';
      history.replaceState(null, '', f === 'sve' ? location.pathname : `#${f}`);
      apply(f, true);
    }),
  );
  window.addEventListener('hashchange', () => apply(location.hash.slice(1) || 'sve', true));
  apply(location.hash.slice(1) || 'sve');
</script>
