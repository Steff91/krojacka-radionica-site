---
import '../styles/global.css';
import Header from '../components/Header.astro';
import TopBar from '../components/TopBar.astro';
import Footer from '../components/Footer.astro';
import BackToTop from '../components/BackToTop.astro';
import CookieBanner from '../components/CookieBanner.astro';
import FormEnhance from '../components/FormEnhance.astro';
import { getLang, getInfo, t, HTML_LANG, LANGS, type Alternates } from '../i18n';
// Above-the-fold fonts, preloaded so text doesn't flash in a fallback font on first load
import cg500 from '@fontsource/cormorant-garamond/files/cormorant-garamond-latin-500-normal.woff2?url';
import cg500ext from '@fontsource/cormorant-garamond/files/cormorant-garamond-latin-ext-500-normal.woff2?url';
import cg500i from '@fontsource/cormorant-garamond/files/cormorant-garamond-latin-500-italic.woff2?url';
import cg600 from '@fontsource/cormorant-garamond/files/cormorant-garamond-latin-600-normal.woff2?url';
import dm300 from '@fontsource/dm-sans/files/dm-sans-latin-300-normal.woff2?url';
import dm500 from '@fontsource/dm-sans/files/dm-sans-latin-500-normal.woff2?url';
const preloadFonts = [cg500, cg500ext, cg500i, cg600, dm300, dm500];

interface Props {
  title: string;
  description?: string;
  /** Extra JSON-LD objects for this page (e.g. a Service) */
  schema?: Record<string, unknown>[];
  /** URL of this page in each language (drives hreflang and the language switcher) */
  alternates?: Alternates;
  /** Social share image (path under public/); defaults to /og-default.jpg */
  image?: string;
}

const lang = getLang(Astro.url);
const ui = t(lang);
const info = getInfo(lang);
const { title, description = ui.meta.siteDescription, schema = [], alternates = {}, image = '/og-default.jpg' } = Astro.props;
const ogImage = new URL(image, Astro.site);

const canonical = new URL(Astro.url.pathname, Astro.site);
const hreflangs = LANGS.filter((l) => alternates[l]).map((l) => ({ hreflang: HTML_LANG[l], href: new URL(alternates[l]!, Astro.site) }));
const xDefault = alternates.sr ? new URL(alternates.sr, Astro.site) : null;
const ogAlt = LANGS.filter((l) => l !== lang && alternates[l]).map((l) => t(l).meta.ogLocale);

const business = {
  '@context': 'https://schema.org',
  '@type': 'LocalBusiness',
  '@id': new URL('/#radionica', Astro.site).toString(),
  inLanguage: HTML_LANG[lang],
  name: info.name,
  description,
  telephone: info.phoneHref,
  url: Astro.site?.toString(),
  image: new URL('/logo.png', Astro.site).toString(),
  address: {
    '@type': 'PostalAddress',
    streetAddress: `${info.address}, ${info.addressNote}`,
    addressLocality: info.city,
    addressCountry: 'RS',
  },
  hasMap: info.mapsLink,
  // Keep in sync with data/<lang>/site.json → hours
  openingHoursSpecification: [
    { '@type': 'OpeningHoursSpecification', dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday'], opens: '09:00', closes: '17:00' },
    { '@type': 'OpeningHoursSpecification', dayOfWeek: 'Saturday', opens: '08:00', closes: '12:00' },
  ],
  sameAs: [info.instagram, info.pinterest, info.youtube, info.googleReviews].filter((u) => u.startsWith('http')),
};
---

<!doctype html>
<html lang={HTML_LANG[lang]}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {import.meta.env.PUBLIC_NOINDEX === 'true' && <meta name="robots" content="noindex, nofollow" />}
    <link rel="canonical" href={canonical} />
    {hreflangs.length > 1 && hreflangs.map((h) => <link rel="alternate" hreflang={h.hreflang} href={h.href} />)}
    {hreflangs.length > 1 && xDefault && <link rel="alternate" hreflang="x-default" href={xDefault} />}
    <link rel="icon" type="image/png" href="/favicon.png" />
    {preloadFonts.map((href) => <link rel="preload" as="font" type="font/woff2" href={href} crossorigin />)}
    <meta property="og:type" content="website" />
    <meta property="og:locale" content={ui.meta.ogLocale} />
    {ogAlt.map((l) => <meta property="og:locale:alternate" content={l} />)}
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content={info.name} />
    <meta property="og:image" content={ogImage} />
    {image === '/og-default.jpg' && <><meta property="og:image:width" content="1200" /><meta property="og:image:height" content="630" /></>}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="theme-color" content="#FDFAF6" />
    <script is:inline>document.documentElement.classList.add('js');</script>
    <script type="application/ld+json" set:html={JSON.stringify(business)} />
    {schema.map((s) => <script type="application/ld+json" set:html={JSON.stringify(s)} />)}
    <slot name="head" />
  </head>
  <body>
    <TopBar alternates={alternates} />
    <Header alternates={alternates} />
    <main>
      <slot />
    </main>
    <Footer />
    <BackToTop />
    <CookieBanner />
    <FormEnhance />

    <script>
      // Subtle reveal: elements with [data-reveal] fade up once, staggered by --i.
      const items = document.querySelectorAll<HTMLElement>('[data-reveal]');
      if ('IntersectionObserver' in window) {
        const io = new IntersectionObserver(
          (entries) => {
            for (const e of entries) {
              if (e.isIntersecting) {
                e.target.classList.add('is-visible');
                io.unobserve(e.target);
              }
            }
          },
          { rootMargin: '0px 0px -8% 0px', threshold: 0.1 },
        );
        items.forEach((el) => io.observe(el));
      } else {
        items.forEach((el) => el.classList.add('is-visible'));
      }
    </script>
  </body>
</html>
