---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Placeholder from '../../components/Placeholder.astro';
import Process from '../../components/sections/Process.astro';
import Contact from '../../components/sections/Contact.astro';

export async function getStaticPaths() {
  const services = await getCollection('services');
  return services.map((s) => ({ params: { slug: s.id }, props: { service: s } }));
}

const { service } = Astro.props;
const d = service.data;
const featured = d.variant === 'featured';

const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'Service',
    name: d.title,
    description: d.seoDescription ?? d.excerpt,
    areaServed: 'Beograd',
    provider: { '@id': new URL('/#radionica', Astro.site).toString() },
  },
];
---

<Base title={d.seoTitle ?? `${d.title} po meri | Krojačka radionica Beograd`} description={d.seoDescription ?? d.excerpt} schema={schema}>
  <section class:list={['py-16 sm:py-24', featured && 'bg-ink text-on-dark']}>
    <div class="container-site grid items-center gap-16 lg:grid-cols-2">
      <div class="flex flex-col gap-6">
        <p class:list={['m-0 text-[13px]', featured ? 'text-on-dark-muted' : 'text-muted']}>
          <a href="/" class:list={[featured ? 'text-on-dark-muted hover:text-gold' : 'text-muted']}>Početna</a> / {d.title}
        </p>
        <p class:list={['eyebrow !mb-0', featured && '!text-gold']}>{featured ? 'Za dizajnere i brendove' : 'Usluge'}</p>
        <h1 class="h-display">
          {d.heroTitle}{d.heroTitleEm && <> <em class:list={['font-normal', featured ? 'text-gold' : 'text-red']}>{d.heroTitleEm}</em></>}
        </h1>
        <p class:list={['lead text-[19px]', featured && '!text-[#D9D0C5]']}>{d.intro}</p>
        <div>
          <a href="#kontakt" class:list={['btn', featured ? 'btn-gold' : 'btn-dark']}>Zakažite konsultaciju</a>
        </div>
      </div>
      <Placeholder label={d.imageLabel} src={d.image} alt={d.title} tone={featured ? 'dark' : 'sand'} class="h-[420px] sm:h-[560px]" />
    </div>
  </section>

  {d.gallery.length > 0 && (
    <section class="py-18 sm:py-28">
      <div class="container-site flex flex-col gap-10">
        <div>
          <p class="eyebrow">Naš rad</p>
          <h2 class="h-section">Izabrani radovi</h2>
        </div>
        <div class="grid grid-cols-2 gap-3 md:grid-cols-4">
          {d.gallery.map((img) => <Placeholder label={img.alt} src={img.src} alt={img.alt} class="aspect-[4/5]" />)}
        </div>
      </div>
    </section>
  )}

  <Process />

  {d.faq.length > 0 && (
    <section class="py-18 sm:py-28">
      <div class="container-site grid gap-16 lg:grid-cols-[0.8fr_1.2fr]">
        <div>
          <p class="eyebrow">Česta pitanja</p>
          <h2 class="h-section">Pitanja o usluzi</h2>
        </div>
        <div>
          {d.faq.map((f) => (
            <details class="border-t border-line py-6 last:border-b">
              <summary class="min-h-11 cursor-pointer font-serif text-[24px] font-medium">{f.q}</summary>
              <p class="mt-3 mb-0 text-body">{f.a}</p>
            </details>
          ))}
        </div>
      </div>
    </section>
  )}

  <Contact service={d.title} />
</Base>
