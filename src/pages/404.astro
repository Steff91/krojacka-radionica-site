---
import Base from '../layouts/Base.astro';
---

<Base title="Stranica nije pronađena | Krojačka radionica">
  <section class="py-24 sm:py-32">
    <div class="container-site flex max-w-[640px] flex-col gap-6">
      <p class="eyebrow !mb-0">Greška 404</p>
      <h1 class="h-display">Ova stranica <em class="font-normal text-red">ne postoji</em></h1>
      <p class="lead text-[19px]">Možda je adresa pogrešno ukucana ili je stranica premeštena.</p>
      <div class="flex flex-wrap gap-4">
        <a href="/" class="btn btn-dark">Početna</a>
        <a href="/usluge/" class="btn btn-outline">Usluge</a>
      </div>
    </div>
  </section>
</Base>
